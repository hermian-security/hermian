# Normalise to LF in the repository. Shell scripts, systemd units and the
# Debian maintainer scripts must be LF on disk or they fail on the target.
* text=auto eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
packaging/debian/* text eol=lf
tests/soak/* text eol=lf

# Binary
*.o binary
*.png binary
