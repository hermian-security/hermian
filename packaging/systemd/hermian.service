[Unit]
Description=Hermian defensive security daemon
Documentation=https://github.com/hermian-security/hermian
After=network-online.target local-fs.target
Wants=network-online.target
# Never give up restarting: a start limit left the unit failed (and the host
# unmonitored, silently) after five quick crashes.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%EXEC% run
ExecReload=/bin/kill -HUP $MAINPID
# Any exit not requested through systemctl brings it back. A manual
# `systemctl stop` still stops it (and the daemon pages that it's stopping).
Restart=always
RestartSec=5
KillSignal=SIGTERM
# Leaves room for the stop notice (the daemon waits up to 6 s for delivery).
TimeoutStopSec=20
UMask=0077
# eBPF maps and perf ring buffers are locked memory; the 64 KiB default makes
# the perf mmap fail with EPERM on multi-core hosts.
LimitMEMLOCK=infinity
LimitNOFILE=65536

# State and logs are owned by systemd so ProtectSystem=strict still allows them.
RuntimeDirectory=hermian
RuntimeDirectoryMode=0700
StateDirectory=hermian
StateDirectoryMode=0700
LogsDirectory=hermian
LogsDirectoryMode=0700
ConfigurationDirectory=hermian
ConfigurationDirectoryMode=0700

# Hardening. The daemon needs read access to all of /proc and /etc, write
# access only to its own directories, and the capabilities listed below.
ProtectSystem=strict
ReadWritePaths=/etc/hermian
# PrivateTmp must stay OFF: it would give the daemon an empty private /tmp and
# hide exactly the directories attackers stage payloads in. The daemon never
# writes to /tmp itself.
PrivateTmp=false
NoNewPrivileges=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
KeyringMode=private
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# A preload rootkit hooks every dynamically linked program at exec: the
# daemon and the tools it runs (journalctl, nft, systemctl) too. In the
# service's mount namespace /etc/ld.so.preload is /dev/null, so nothing is
# preloaded, whatever the host's copy says now or later; Hermian judges that
# copy through /proc/1/root. A bind mount, not InaccessiblePaths=-: with the
# "-", systemd first asks whether the file exists, and a rootkit already in
# PID 1 answers no (seen on a perfctl host). Without a file to mount over,
# systemd creates an empty one, which loads nothing.
BindReadOnlyPaths=/dev/null:/etc/ld.so.preload
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
# MemoryDenyWriteExecute is intentionally NOT set: the eBPF perf ring buffer
# requires a shared writable mmap and the option blocks it (EPERM at mmap).
SystemCallArchitectures=native
%CAP_BOUNDING%
%CAP_AMBIENT%

[Install]
WantedBy=multi-user.target
