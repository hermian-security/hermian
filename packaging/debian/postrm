#!/bin/sh
set -e

# Every unit `hermian enable` writes (hermian uninstall removes the same set).
remove_units() {
    rm -f /etc/systemd/system/hermian.service \
        /etc/systemd/system/hermian-watchdog.service \
        /etc/systemd/system/hermian-watchdog.timer
    systemctl daemon-reload >/dev/null 2>&1 || true
}

# The module is gone after remove, so its PAM lines must go too; the
# comment line and the backup go with them. Same filter as hermian uninstall.
remove_pam_hook() {
    if [ -f /etc/pam.d/sshd ] && grep -q -e 'pam_hermian\.so' -e '# HERMIAN:' /etc/pam.d/sshd 2>/dev/null; then
        sed -i -e '/pam_hermian\.so/d' -e '/# HERMIAN:/d' /etc/pam.d/sshd
    fi
}

case "$1" in
    remove)
        remove_pam_hook
        remove_units
    ;;
    purge)
        remove_pam_hook
        rm -f /etc/pam.d/sshd.hermian-bak
        rm -rf /etc/hermian /var/lib/hermian /var/log/hermian /run/hermian
        rm -f /etc/sysctl.d/60-hermian.conf
        remove_units
    ;;
esac

exit 0
